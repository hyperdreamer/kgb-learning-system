{
  "manifest_version": 3,
  "name": "KGB Sentence Capture",
  "version": "1.1.0",
  "description": "Send selected webpage text to the local KGB SRS app.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "KGB Sentence Capture"
  },
  "commands": {
    "send-selected-text": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "MacCtrl+K"
      },
      "description": "Send selected text to KGB"
    }
  }
}
